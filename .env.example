# ============================================================================
#  LYS-LF.COM — OPS SECRETS TEMPLATE  (COMMITTED — placeholders only)
# ============================================================================
#  Copy to `.env` (gitignored) and fill real values from the vault.
#  This template is safe to commit: NO real secrets here.
#  Real secrets belong ONLY in `.env` (ignored by .gitignore `.env*`).
#
#  These are OPS/infra secrets — NOT read by Next.js. App build vars go in
#  lys-lf-react-19/.env.local (see lys-lf-react-19/.env.example).
# ============================================================================

# --- Bluehost account / domain registrar --------------------------------
BLUEHOST_ACCOUNT_DOMAIN='lys-lf.com'
BLUEHOST_ACCOUNT_PASSWORD=''
BLUEHOST_DOMAIN_SECURITY_PIN=''

# --- cPanel / SSH (same login) ------------------------------------------
CPANEL_USER='${CPANEL_USER}'
CPANEL_HOME='${CPANEL_HOME}'
CPANEL_WEBROOT='${CPANEL_HOME}/public_html'
CPANEL_SHARED_IP='${SHARED_IP}'
CPANEL_PASSWORD=''
SSH_HOST='lys-lf.com'
SSH_USER='${CPANEL_USER}'
SSH_PORT='22'
SSH_KEY=''                    # abs path to PRIVATE key (e.g. /c/Users/<you>/.ssh/lyslf)
SSH_KEY_PASSPHRASE=''         # passphrase for the key (kept ONLY here, gitignored)
SSH_KEY_FINGERPRINT=''        # SHA256:... identity check (not secret)

# --- Email mailboxes -----------------------------------------------------
EMAIL_ADMIN_ADDRESS='admin@lys-lf.com'
EMAIL_ADMIN_PASSWORD=''
EMAIL_NOREPLY_ADDRESS='noreply@lys-lf.com'
EMAIL_NOREPLY_PASSWORD=''

# --- FTP -----------------------------------------------------------------
FTP_HOST='lys-lf.com'
FTP_PRIMARY_USER='${CPANEL_USER}'
FTP_PRIMARY_PASSWORD=''
# FTPS deploy target dirs (relative to FTP login home):
FTPS_STAGING_DIR='/staging'
FTPS_PROD_DIR='/public_html'

# --- Analytics / maps ----------------------------------------------------
GA4_MEASUREMENT_ID=''
GOOGLE_MAPS_API_KEY=''

# --- Deploy pipeline (rsync-over-SSH; read by scripts/deploy.sh) ---------
# See lys-lf-react-19/docs/ops/DEPLOY.agent.md for setup + runbook.
SSH_KEY=''                    # path to PRIVATE deploy key
STAGING_PATH='${CPANEL_HOME}/staging'
PROD_PATH='${CPANEL_HOME}/public_html'
VERIFY_URL_STAGING='https://staging.lys-lf.com'
VERIFY_URL_PROD='https://lys-lf.com'
