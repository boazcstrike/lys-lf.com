# ============================================================================
#  APP BUILD VARS TEMPLATE (COMMITTED — placeholders only)
# ============================================================================
#  Copy to `.env.local` (gitignored) and fill real values.
#
#  NEXT_PUBLIC_* are PUBLIC: inlined into the static bundle, visible to every
#  browser. They are NOT secrets. Ops secrets go in the repo-root ../.env.
# ============================================================================

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Unset = no GA in build.
# See docs/SECURITY.md APP-1: prod consent UI is gated OFF today.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Maps JavaScript API key. Restrict by HTTP referrer in GCP console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
