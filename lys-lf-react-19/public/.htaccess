# Lim & Yutatco-Sze — static export served from Bluehost public_html (Apache).
# Copied verbatim into out/ by `next build` (static export copies public/).
# next.config.ts uses output:'export' so Next cannot emit HTTP headers —
# they must be set here at the Apache layer.

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Clickjacking. frame-ancestors (CSP) is the modern form; X-Frame-Options
  # kept for older browsers.
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HTTPS only — Bluehost serves this site over TLS. Moderate max-age, no
  # preload (reversible if TLS is ever interrupted).
  Header always set Strict-Transport-Security "max-age=15552000"

  # Content Security Policy.
  #   script  : self + Google Analytics/Tag Manager. 'unsafe-inline' is
  #             required — a static export cannot generate per-request
  #             nonces, and both the Consent Mode bootstrap and Next's
  #             runtime emit inline scripts.
  #   style   : 'unsafe-inline' for Tailwind/runtime inline styles.
  #   font    : self — next/font self-hosts the Google fonts at build.
  #   img/connect: GA endpoints for measurement + Consent Mode.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com"

  # Long-lived immutable cache for fingerprinted Next assets.
  <FilesMatch "\.(?:js|css|woff2?|webp|avif|png|jpg|jpeg|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML must always revalidate so deploys are picked up immediately.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Clean URLs / SPA-style fallbacks
# trailingSlash:true emits /privacy/index.html, so directory requests resolve
# natively. Map a missing extensionless path to its index.html, else 404.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Serve existing files/directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /path -> /path/index.html when that exists.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Block dotfiles (defence in depth — don't serve this .htaccess itself).
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
